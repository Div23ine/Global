# Meridian API — environment template. Copy to .env and fill real values.
# NEVER commit .env. NEVER put secret values in frontend/ code.

# --- Core ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Single allowed origin for the browser frontend (comma-separated for multiple)
CORS_ORIGIN=http://localhost:4173

# --- Clerk (https://dashboard.clerk.com) ---
# Server-side secret (NEVER expose to the frontend)
CLERK_SECRET_KEY=clerk_secret_key_placeholder
# Same publishable key the frontend uses (used for webhook validation context)
CLERK_PUBLISHABLE_KEY=pk_live_or_test_placeholder
# Svix signing secret from Clerk Dashboard -> Webhooks -> endpoint
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Supabase (https://supabase.com/dashboard) ---
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# Anon/public key (safe for RLS-scoped queries)
SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Service role key — SERVER ONLY, bypasses RLS
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Twilio (https://console.twilio.com) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+00000000000
# Comma-separated E.164 allowlist for dev SMS (empty = no restriction in dev)
TWILIO_ALLOWED_RECIPIENTS=

# --- Payments seam ---
# Provider id activated for deposit handoff. Only "manual-review" ships by default;
# a licensed partner integration registers its id here.
PAYMENT_PROVIDER=manual-review
# HMAC secret for /webhooks/payments/:provider (per-provider in production)
PAYMENT_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Rate limiting (defaults; per-IP unless noted) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_DEPOSIT_PER_MIN=10
RATE_LIMIT_SUPPORT_PER_MIN=5
RATE_LIMIT_SMS_PER_HOUR=20

# --- Session/behavior ---
STATEMENT_NOTE=Generated by Meridian Global Accounts (provisional format)
