# Meridian API — environment template.
# Local Node: copy to .env and fill real values.
# Cloudflare Workers: set the same names via `wrangler secret put` / [vars].
# NEVER commit .env. NEVER put secret values in frontend/ code.

# --- Core ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Allowed browser origins (comma-separated). Production: Cloudflare Pages URL(s).
CORS_ORIGIN=http://localhost:4173

# --- Supabase Auth + Database (https://supabase.com/dashboard) ---
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Twilio SMS (https://console.twilio.com) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+00000000000
TWILIO_ALLOWED_RECIPIENTS=

# --- Resend email (https://resend.com) ---
# Used when admin assigns bank details, deposit credited, refund completed.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@meridian.example.com
RESEND_FROM_NAME=Meridian Global Accounts

# --- Payments seam (manual bank-transfer is primary) ---
PAYMENT_PROVIDER=manual-bank-transfer
PAYMENT_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_DEPOSIT_PER_MIN=10
RATE_LIMIT_SUPPORT_PER_MIN=5
RATE_LIMIT_SMS_PER_HOUR=20

STATEMENT_NOTE=Generated by Meridian Global Accounts (provisional format)
