{
  "name": "meridian-api",
  "version": "1.0.0",
  "private": true,
  "description": "Meridian Global Accounts REST API (Express 5 + TypeScript)",
  "type": "commonjs",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "wrangler types && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "cf:dev": "npx --yes wrangler@4.166.0 dev",
    "cf:deploy": "npx --yes wrangler@4.166.0 deploy",
    "cf:tail": "npx --yes wrangler@4.166.0 tail"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "pino": "^9.4.0",
    "twilio": "^5.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "embedded-postgres": "^18.7.0-beta.19",
    "eslint": "^9.11.0",
    "pg": "^8.23.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.166.0",
    "@cloudflare/workers-types": "^5.20261121.1"
  }
}
